---
import { ui, type Locale } from '../../lib/i18n/ui';
import { localeUrl } from '../../lib/i18n/routes';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = ui(locale);
---

<!doctype html>
<html lang={locale === 'fr' ? 'fr-CA' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t('Syncing Progress')} | HAGAR Pro</title>
		<style>
			:root {
				color-scheme: dark;
			}
			body {
				margin: 0;
				font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
				background: #091022;
				color: #dce7ff;
			}
			main {
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 1.25rem;
			}
			.panel {
				width: min(560px, 100%);
				padding: 1rem 1.1rem;
				border-radius: 0.75rem;
				border: 1px solid #304064;
				background: rgba(16, 22, 38, 0.9);
			}
			h1 {
				margin: 0 0 0.65rem;
				font-size: 1.1rem;
			}
			p {
				margin: 0.25rem 0;
				color: #b9c9e8;
				font-size: 0.95rem;
			}
			a {
				color: #8cd1ff;
			}
		</style>
	</head>
	<body>
		<main>
			<section class="panel">
				<h1>{t('Syncing Progress')}</h1>
				<p id="sync-status">{t('Applying progress data...')}</p>
				<p>
					{t('If this page does not redirect automatically, go to')}
					<a href={localeUrl(locale)}>{t('Curriculum')}</a>.
				</p>
			</section>
		</main>

		<script>
			import { deserializeProgress } from '../../lib/progress/sync';
      import { localeFromLang, ui, localizePath } from '../../lib/i18n/ui';
      const locale = localeFromLang(document.documentElement.lang);
      const t = ui(locale);
			import { mergeProgress } from '../../lib/stores/progressStore';

			const status = document.getElementById('sync-status');
			const params = new URLSearchParams(window.location.search);
			const data = params.get('data');

			(async () => {
				try {
					if (!data) {
						throw new Error(t('No sync data found in this URL.'));
					}

					const incoming = await deserializeProgress(data);
					mergeProgress(incoming);

					if (status) {
						status.textContent = t(incoming.completedLessons.length === 1 ? 'Imported one completed lesson. Redirecting...' : 'Imported {count} completed lessons. Redirecting...', { count: incoming.completedLessons.length });
					}

					window.setTimeout(() => {
						window.location.replace(localizePath(locale));
					}, 650);
				} catch {
					if (status) {
						status.textContent =
							!data ? t('No sync data found in this URL.') : t('Unable to import progress data from this link.');
					}
				}
			})();
		</script>
	</body>
</html>
